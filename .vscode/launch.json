{
    "version": "0.2.0",
    "configurations": [
        {
            //the TypeScript API server (server_ts) - node runs it with tsx registered as a loader, so
            //breakpoints work in the .ts files (tsx makes source maps). --watch restarts it when a file
            //changes, and "restart" reattaches the debugger
            "name": "Launch and Debug Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--watch", "--import", "tsx"],
            "program": "${workspaceFolder}/server_ts/src/server.ts",
            "cwd": "${workspaceFolder}/server_ts",
            "restart": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            //the TypeScript ETL (server_ts/src/etl/run.ts) - asks which stages and options to run, ie
            //"legislators bills --sessions=2026GS". summaries/policies make PAID LLM calls and need --paid
            "name": "Debug ETL",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/server_ts/src/etl/run.ts",
            "args": "${input:etlArgs}",
            "cwd": "${workspaceFolder}/server_ts",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        },
        {
            "name": "Launch and Debug Frontend",
            "type": "firefox",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/react_client",
        },
        {
            "name": "Launch and Debug Fill Database",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "nodemon",
            //"program": "${workspaceFolder}/server/server.js",
            "program": "${workspaceFolder}/server/database/fillDatabase.js",
            "cwd": "${workspaceFolder}/server",
            "restart": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development"
            }
        },
    ],
    "inputs": [
        {
            "id": "etlArgs",
            "type": "promptString",
            "description": "ETL stages and options (empty lists them), ie: legislators bills --sessions=2026GS",
            "default": "--help"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": [
                "Launch and Debug Server",
                "Launch and Debug Frontend"
            ],
            "stopAll": true
        }
    ]
}