{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Debug Server",
            "port": 9229,
            "restart": true,
            "preLaunchTask": "npm run server:dev",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "firefox",
            "request": "launch",
            "name": "Debug Frontend",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/react_client",
            "preLaunchTask": "npm run client:dev"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": [
                "Debug Server",
                "Debug Frontend"
            ],
            "stopAll": true
        }
    ]
}